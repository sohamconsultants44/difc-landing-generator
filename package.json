{
  "name": "ai-landing-generator",
  "version": "1.0.0",
  "description": "DIFC AI-Powered Landing Page Generator - Agentic workflow for generating responsive, SEO-first landing pages",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:e2e": "npm run test:e2e --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "mcp:start": "node scripts/start-mcp-servers.js",
    "verify:ollama": "node scripts/verify-ollama.js",
    "load-data": "tsx scripts/load-campaign-data.ts"
  },
  "keywords": [
    "ai",
    "landing-page",
    "generator",
    "langchain",
    "ollama",
    "nextjs",
    "difc"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "pdfjs-dist": "^5.4.394",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
